{
  "name": "gugak-library",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-local.mjs dev --hostname 0.0.0.0",
    "build": "node scripts/next-local.mjs build",
    "start": "node scripts/next-local.mjs start --hostname 0.0.0.0",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "vitest": "^3.2.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/user-event": "^14.6.0",
    "jsdom": "^26.0.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
